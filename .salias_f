# Unsloth fork (TerminatedProcess/unsloth) - aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Environment ──
# The installed Studio is a SEPARATE artifact from this checkout: it lives in
# ~/.unsloth and is what the systemd unit runs. Editing this repo does not
# change the running service.
set -gx UNSLOTH_GROUP 'unsloth'
# Fallback only -- the group is the real target. Used when the Service Dashboard
# (:8090) is down, so the commands below still work on a bare systemd box.
set -gx UNSLOTH_UNIT 'unsloth-studio.service'
set -gx UNSLOTH_URL 'http://localhost:8889'

# ── Help ──
# Relative path: .salias_f is always sourced with the project dir as PWD.
function help
    clear
    sed "s|UNSLOTH_URL|$UNSLOTH_URL|" ./.salias_help.txt
end

# ── Unsloth Studio service (Service Dashboard group) ──
# Manual-start unit on port 8889, in group "Unsloth" on the Service Dashboard
# (:8090). Port 8889 rather than Unsloth's default 8888 because PortHub
# permanently reserves 8888 for its own admin API.
#
# These act on the GROUP, not on one unit: adding a second service to the
# "unsloth" group in ~/.config/porthub_service_dash/groups.json makes every
# command below cover it automatically, with no edit here. The dashboard also
# starts members in declared order and stops them in reverse, which a bare
# `systemctl start` on one unit cannot do.
alias unstart='svcgroup unsloth start'
alias unstop='svcgroup unsloth stop'
alias unrestart='svcgroup unsloth restart'
alias unstatus='svcgroup unsloth status'

# journalctl is per-unit and svcgroup has no log action, so the group's members
# are read back from the dashboard. Falls back to the lone unit with :8090 down.
function _unsloth_units --description "Units in the Unsloth dashboard group"
    set -l units (curl -sf -m 5 http://localhost:8090/api/services 2>/dev/null | python3 -c '
import json, sys
gid = sys.argv[1]
g = next((x for x in json.load(sys.stdin).get("groups", []) if x.get("id") == gid), None)
for m in (g or {}).get("members", []):
    if m.get("unit"):
        print(m["unit"])
' $UNSLOTH_GROUP 2>/dev/null)
    if test (count $units) -eq 0
        echo $UNSLOTH_UNIT
        return
    end
    printf '%s\n' $units
end

function unlog --description "Last 50 log lines across the Unsloth group"
    set -l args
    for u in (_unsloth_units)
        set -a args -u $u
    end
    journalctl --user $args --no-pager -n 50
end

function unlogf --description "Follow the Unsloth group log"
    set -l args
    for u in (_unsloth_units)
        set -a args -u $u
    end
    journalctl --user $args -f
end

# ── Git (fork sync) ──
# Branch-separated method:
#   main  = verbatim mirror of upstream (unslothai/unsloth). Never commit here.
#   mryan = personal customizations, rebased on top of main.
# Keeping main a strict ancestor of upstream/main means --ff-only always
# succeeds, so conflicts can only ever surface during the mryan rebase --
# resolved once, on the branch that actually owns the changes.
function gitupdate --description "Sync fork from upstream: ff main, rebase mryan on top"
    set -l current (git branch --show-current)

    # Checking out main with a dirty tree could carry stray edits onto the mirror.
    if not git diff --quiet; or not git diff --cached --quiet
        echo "gitupdate: working tree dirty -- commit or stash on mryan first."
        return 1
    end

    echo "gitupdate: fetching upstream..."
    git fetch upstream; or return 1

    echo "gitupdate: fast-forwarding main (mirror of upstream)..."
    git checkout main; or return 1
    if not git merge upstream/main --ff-only
        echo "gitupdate: ff-only refused -- main has drifted from upstream."
        echo "           Something was committed to main that belongs on mryan."
        echo "           Recover: git branch -f mryan main; git reset --hard upstream/main"
        git checkout $current
        return 1
    end
    git push origin main; or return 1

    echo "gitupdate: rebasing mryan onto main..."
    git checkout mryan; or return 1
    if not git rebase main
        echo "gitupdate: rebase stopped on a conflict -- you are mid-rebase on mryan."
        echo "           Resolve, then: git rebase --continue"
        echo "           and finally:   git push origin mryan --force-with-lease"
        return 1
    end
    # Rebase rewrites mryan's history, so the push must overwrite the remote.
    # --force-with-lease (never plain --force) aborts if the remote moved.
    git push origin mryan --force-with-lease; or return 1

    git checkout $current
    echo "gitupdate: done -- main mirrors upstream, mryan rebased on top."
end
